# Cloudflare Tunnel on the restaurant Mac: copy to .env and keep it private (chmod 600 .env).
# See "Cloudflare Tunnel from the restaurant Mac" in docs/PUBLIC_WEBSITE.md.
PORT=3000
# 0.0.0.0 keeps the tablets working over the restaurant Wi-Fi when the internet is down.
MASAFLOW_HOST=0.0.0.0
# Host names only: no https://, port or path. Each one is also the only HTTPS origin its pages may sync from.
MASAFLOW_CUSTOMER_DOMAIN=loshuarachesdezapata.live
MASAFLOW_STAFF_DOMAIN=zapatapos.live
# 12-256 characters, required once the site is public. The four-digit PIN is not used in this mode.
MASAFLOW_STAFF_PASSWORD=
# Bank details embedded at build time (see docs/PUBLIC_WEBSITE.md). Rebuild after changing them.
VITE_BANK_NAME=
VITE_BANK_CLABE=
VITE_BANK_BENEFICIARY=
VITE_BANK_CONCEPT_PREFIX=
