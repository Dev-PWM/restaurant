{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "zapata-restaurant",
  "account_id": "821abce2fbab4f1f34b4b0ff6bbb5f06",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    { "pattern": "loshuarachesdezapata.live/*", "zone_id": "c8d3d02f18128d9b68355c3a19371cd7" },
    { "pattern": "zapatapos.live/*", "zone_id": "8a53ab0740d408e496431e1e4be02c84" }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "durable_objects": { "bindings": [{ "name": "RESTAURANT", "class_name": "Restaurant" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Restaurant"] }],
  "vars": {
    "CUSTOMER_DOMAIN": "loshuarachesdezapata.live",
    "STAFF_DOMAIN": "zapatapos.live"
  },
  "observability": { "enabled": false }
}
