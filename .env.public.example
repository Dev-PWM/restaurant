# Copy to .env on the public host and keep it private (chmod 600 .env).
MASAFLOW_DOMAIN=orders.example.com
MASAFLOW_STAFF_PASSWORD=
# Public bank details embedded during the build. Empty values use the restaurant defaults.
# Verify the account before accepting transfers; rebuild after changing these values.
VITE_BANK_NAME=
VITE_BANK_CLABE=
VITE_BANK_BENEFICIARY=
VITE_BANK_CONCEPT_PREFIX=
