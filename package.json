{
  "name": "masaflow-cash-pos",
  "version": "0.3.0",
  "private": true,
  "description": "MasaFlow upfront cash ordering and drawer reconciliation",
  "workspaces": [
    "apps/client-web",
    "apps/business-pos",
    "apps/analytics"
  ],
  "scripts": {
    "setup": "npm ci",
    "build": "npm run typecheck && vite build --config vite.realtime.config.mts --mode client-web && vite build --config vite.realtime.config.mts --mode business-pos && vite build --config vite.realtime.config.mts --mode analytics",
    "build:css": "tailwindcss -i styles/masaflow.css -o assets/masaflow.css --minify",
    "start": "node server.js",
    "start:inspect": "node --inspect=127.0.0.1:9229 server.js",
    "admin:hash": "node scripts/admin-hash.cjs",
    "loadtest": "node scripts/loadtest.cjs",
    "loadtest:assets": "node scripts/loadtest.cjs --only=assets",
    "loadtest:sockets": "node scripts/loadtest.cjs --only=sockets",
    "scan": "npm run scan:regex && npm run scan:deps",
    "scan:regex": "node scripts/scan-regex.cjs",
    "scan:deps": "node -e \"try { require('child_process').execSync('npm audit --omit=dev --package-lock-only', { stdio: 'inherit', env: { ...process.env, npm_config_allow_scripts: '' } }); } catch (e) { process.exit(e.status || 1); }\"",
    "scan:sast": "semgrep scan --config .semgrep/masaflow.yml --error --severity ERROR --metrics=off server.js shared apps scripts artillery",
    "scan:secrets": "gitleaks detect --source . --config .gitleaks.toml --redact --verbose",
    "dev": "node scripts/dev.cjs",
    "lint": "tsc --noEmit",
    "test": "node --test tests/*.test.js",
    "start:mac": "bash Start_MasaFlow.command",
    "typecheck": "tsc --noEmit",
    "test:realtime": "node --test tests/realtime.test.js",
    "legacy:start": "node legacy-server.cjs",
    "legacy:build": "npm --prefix apps/analytics run build",
    "legacy:backup": "node scripts/data.cjs backup",
    "legacy:backups": "node scripts/data.cjs list",
    "legacy:backup:verify": "node scripts/data.cjs verify",
    "legacy:restore": "node scripts/data.cjs restore",
    "legacy:startup:enable": "node scripts/mac-login.cjs install",
    "legacy:startup:disable": "node scripts/mac-login.cjs uninstall",
    "legacy:startup:status": "node scripts/mac-login.cjs status"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@socket.io/admin-ui": "^0.5.1",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "lucide-react": "^1.52.0",
    "pino": "^10.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.6",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autocannon": "^8.0.0",
    "jsqr": "^1.4.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "overrides": {
    "@parcel/watcher": "^2.6.0"
  }
}
