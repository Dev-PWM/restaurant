{
  "name": "masaflow-cash-pos",
  "version": "0.3.0",
  "private": true,
  "description": "MasaFlow upfront cash ordering and drawer reconciliation",
  "workspaces": [
    "apps/client-web",
    "apps/business-pos",
    "apps/analytics"
  ],
  "scripts": {
    "setup": "npm ci",
    "build": "npm run typecheck && vite build --config vite.realtime.config.mts --mode client-web && vite build --config vite.realtime.config.mts --mode business-pos && vite build --config vite.realtime.config.mts --mode analytics",
    "build:css": "npx --yes tailwindcss@3.4.17 -c tailwind.config.js -i styles/masaflow.css -o assets/masaflow.css --minify",
    "start": "node server.js",
    "dev": "node scripts/dev.cjs",
    "test": "node --test tests/*.test.js",
    "start:mac": "bash Start_MasaFlow.command",
    "typecheck": "tsc --noEmit",
    "test:realtime": "node --test tests/realtime.test.js",
    "legacy:start": "node legacy-server.cjs",
    "legacy:build": "npm --prefix apps/analytics run build",
    "legacy:backup": "node scripts/data.cjs backup",
    "legacy:backups": "node scripts/data.cjs list",
    "legacy:backup:verify": "node scripts/data.cjs verify",
    "legacy:restore": "node scripts/data.cjs restore",
    "legacy:startup:enable": "node scripts/mac-login.cjs install",
    "legacy:startup:disable": "node scripts/mac-login.cjs uninstall",
    "legacy:startup:status": "node scripts/mac-login.cjs status"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "autoprefixer": "^10.6.1",
    "express": "^5.2.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4.3.3"
  }
}
