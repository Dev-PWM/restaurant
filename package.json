{
  "name": "masaflow-cash-pos",
  "version": "0.2.0",
  "private": true,
  "description": "MasaFlow upfront cash ordering and drawer reconciliation",
  "workspaces": [
    "apps/analytics"
  ],
  "scripts": {
    "setup": "npm --prefix apps/analytics ci",
    "build": "npm --prefix apps/analytics run build",
    "build:css": "npx --yes tailwindcss@3.4.17 -c tailwind.config.js -i styles/masaflow.css -o assets/masaflow.css --minify",
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test tests/*.test.js",
    "backup": "node scripts/data.cjs backup",
    "backups": "node scripts/data.cjs list",
    "backup:verify": "node scripts/data.cjs verify",
    "restore": "node scripts/data.cjs restore",
    "start:mac": "node scripts/mac-start.cjs",
    "startup:enable": "node scripts/mac-login.cjs install",
    "startup:disable": "node scripts/mac-login.cjs uninstall",
    "startup:status": "node scripts/mac-login.cjs status"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  }
}
