{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "allowJs": true, "checkJs": false, "skipLibCheck": true,
    "esModuleInterop": true, "resolveJsonModule": true, "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": ["server.js", "shared/realtime/**/*", "shared/ui/**/*", "shared/types/realtime.ts", "apps/client-web/src/**/*.tsx", "apps/business-pos/src/**/*.tsx", "apps/analytics/src/content/realtime/**/*.tsx", "vite.realtime.config.mts"]
}
