PORT=3000
MASAFLOW_HOST=0.0.0.0
MASAFLOW_STAFF_PIN=1234
MASAFLOW_DATA_DIR=
# Structured logs: one JSON file per day (server_YYYY-MM-DD.log). Default: ./logs
MASAFLOW_LOG_DIR=
# trace | debug | info | warn | error
MASAFLOW_LOG_LEVEL=info
# Optional Socket.io Admin UI at /admin-ui/ (this computer only, read-only).
# Generate the value with: npm run admin:hash
MASAFLOW_ADMIN_PASSWORD_HASH=
