# Set these in the server environment. Never use VITE_ or browser-side variables.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-6-luna
# Optional ESC/POS printer on the local network:
MASAFLOW_PRINTER_HOST=
MASAFLOW_PRINTER_PORT=9100

# Optional store location (defaults to this project’s .masaflow directory):
# MASAFLOW_DATA_DIR=/absolute/path/to/masaflow-data

# Staff access: required before exposing the server to a network or public proxy.
# Use a unique password of at least 12 characters; leave unset only for localhost development.
MASAFLOW_STAFF_PASSWORD=
# Public origin when using an HTTPS reverse proxy (no path or trailing slash):
# MASAFLOW_PUBLIC_ORIGIN=https://orders.your-domain.com
# Docker Compose uses this hostname to configure HTTPS and the public origin:
# MASAFLOW_DOMAIN=orders.your-domain.com
